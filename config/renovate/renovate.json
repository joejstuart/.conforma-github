{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":disableDependencyDashboard"
  ],
  "ignorePresets": [
    ":dependencyDashboard"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "timezone": "America/New_York",
  "constraints": {
    "go": "1.23"
  },

  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go", "toolchain"],
      "matchUpdateTypes": ["patch"],
      "postUpdateOptions": ["gomodTidy1.23"],
      "groupName": "Go version"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "!go",
        "!toolchain"
      ],
      "postUpdateOptions": ["gomodTidy1.23"],
      "groupName": "Go module"
    },
    {
      "matchManagers": ["asdf"],
      "matchDepNames": ["golang"],
      "matchUpdateTypes": ["patch"],
      "groupName": "asdf"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["docker.io/library/golang"],
      "matchUpdateTypes": ["patch"],
      "allowedVersions": ">=1.23.0 <1.24.0",
      "groupName": "Go Docker"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "!docker.io/library/golang"
      ],
      "versioning": "semver",
      "groupName": "Docker"
    }
  ]
}
